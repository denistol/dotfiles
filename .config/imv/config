[options]
# Checkerboard background for transparent images
background = checks
# Scale down to fit window on open
scaling_mode = shrink

[binds]
# Arrow navigation
<Left> = prev
<Right> = next
<Space> = next
<BackSpace> = prev

# Additional standard keys
<bracketleft> = prev
<bracketright> = next
p = prev
n = next

# Zoom and positioning
<Up> = zoom 1
<Down> = zoom -1
<Shift+Up> = zoom actual
<Shift+Down> = zoom 0
w = zoom 0
W = zoom actual

# Rotation
r = rotate by 90
<Shift+R> = rotate by -90

# Fullscreen
f = fullscreen
<Return> = fullscreen

# Exit
q = quit
<Escape> = quit
x = close
