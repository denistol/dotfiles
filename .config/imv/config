[options]
# Показывать фон шахматкой для прозрачных изображений
background = checks
# Автоматически масштабировать под окно при открытии
scaling_mode = shrink

[binds]
# Навигация стрелками (работает независимо от раскладки EN/RU)
<Left> = prev
<Right> = next
<Space> = next
<BackSpace> = prev

# Дополнительно стандартные кнопки
<bracketleft> = prev
<bracketright> = next
p = prev
n = next

# Зум и позиционирование
<Up> = zoom 1
<Down> = zoom -1
<Shift+Up> = zoom actual
<Shift+Down> = zoom 0
w = zoom 0
W = zoom actual

# Повороты
r = rotate by 90
<Shift+R> = rotate by -90

# Полноэкранный режим
f = fullscreen
<Return> = fullscreen

# Выход
q = quit
<Escape> = quit
x = close
