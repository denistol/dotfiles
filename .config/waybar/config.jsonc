{
    "layer": "top",
    "position": "top",
    "margin-top": 3,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "hyprland/language",
        "pulseaudio",
        "cpu",
        "memory",
        "tray",
        "custom/lock"
    ],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/window": {
        "format": "󰣆  {title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "hyprland/language": {
        "format": "󰌌  {}",
        "format-en": "US",
        "format-ru": "RU",
        "keyboard-name": "denis’s-keyboard"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Mute",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "interval": 3,
        "format": "󰻠 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M:%S}",
        "format-alt": "󰃭 {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    "custom/lock": {
        "format": "󰌾",
        "on-click": "hyprlock",
        "tooltip": false
    }
}
