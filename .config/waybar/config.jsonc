{
	"layer": "top",
	"position": "bottom",
	"margin-top": 0,
	"margin-left": 10,
	"margin-right": 10,
	"margin-bottom": 4,
	"height": 32,
	"spacing": 4,

	"modules-left": [
		// "custom/omarchy",
		"hyprland/workspaces",
		"hyprland/window",
	],
	"modules-center": ["clock"],
	"modules-right": [
		"pulseaudio",
		"cpu",
		"memory",
		"hyprland/language",
		"tray",
		"custom/lock",
	],

	"custom/omarchy": {
		"format": "󰣇",
		"tooltip": false,
		"on-click": "rofi -show drun || wofi --show drun",
	},

	"hyprland/workspaces": {
		"disable-scroll": false,
		"all-outputs": true,
		"format": "{name}",
		"persistent-workspaces": {
			"*": [1, 2, 3, 4, 5],
		},
	},

	"hyprland/window": {
		"format": "󰣆  {title}",
		"max-length": 40,
		"separate-outputs": true,
	},

	"clock": {
		"interval": 1,
		"format": "󰥔  {:%H:%M:%S}",
		"format-alt": "󰃭  {:%A, %d %B %Y}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
	},

	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": "󰝟 Mute",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"],
		},
		"on-click": "pavucontrol",
		"scroll-step": 5,
	},

	"cpu": {
		"interval": 3,
		"format": "󰻠  {usage}%",
		"tooltip": true,
	},

	"memory": {
		"interval": 5,
		"format": "󰍛  {used:0.1f}G",
		"tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
	},

	"hyprland/language": {
		"format": "󰌌  {}",
		"format-en": "US",
		"format-ru": "RU",
		"on-click": "hyprctl switchxkblayout current next",
	},

	"tray": {
		"icon-size": 15,
		"spacing": 8,
	},

	"custom/lock": {
		"format": "󰌾",
		"on-click": "hyprlock",
		"tooltip": false,
	},
}
